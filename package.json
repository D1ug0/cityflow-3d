{
  "name": "cityflow-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.json *.ts *.js index.html README.md",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "^6.8.0",
    "pinia": "^3.0.0",
    "three": "^0.180.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "pbf": "^5.1.2",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0"
  }
}
